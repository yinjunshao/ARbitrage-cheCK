# Google AI Studio key (https://aistudio.google.com/apikey). Never commit .env.
GEMINI_API_KEY=
# Confirm the exact model ID in AI Studio; per-call overrides are optional.
GEMINI_MODEL=gemini-4-argon
# FRAME_JUDGE_MODEL=
# FRAME_RULES_MODEL=
# FRAME_NARRATE_MODEL=
# fake = placeholder numbers (default until the core lands), real = import the numeric core
FRAME_CORE=fake
FRAME_KALSHI_MEMBER=0
# hashing = skip the bge-small download
# FRAME_EMBEDDER=hashing
