# Google AI Studio key (https://aistudio.google.com/apikey). Never commit .env.
GEMINI_API_KEY=
# Confirm the exact model ID in AI Studio; per-call overrides are optional.
GEMINI_MODEL=gemini-4-argon
# FRAME_JUDGE_MODEL=
# FRAME_RULES_MODEL=
# FRAME_NARRATE_MODEL=
# arbcheck = the real numeric core in arbcheck-project/ ; fake = placeholder numbers (unit tests only)
FRAME_CORE=arbcheck
# Kalshi on/off. 1 ONLY if you are a Kalshi member running this on your own computer (its Developer
# Agreement limits API data to a member's own trading; nothing from Kalshi is saved or shared).
FRAME_KALSHI_MEMBER=0
# hashing = skip the bge-small download
# FRAME_EMBEDDER=hashing
# Time rules R5/R6: only suggest pairs that close within this many days, and within this many days of each other.
# FRAME_MAX_DAYS_TO_CLOSE=45
# FRAME_MAX_CLOSE_GAP_DAYS=14
# Yes + No checks per scan (needs real order books, 2 requests each; no LLM):
# FRAME_MAX_SINGLES_PER_SCAN=30
# Date/threshold ladders and in-game links screened by the core per scan (no LLM):
# FRAME_MAX_SCREENS_PER_SCAN=40
# Smart watch loop: how often to look for due re-checks (s); 0 turns the app's own loop off (e.g. when the
# monitor is already running on the same markets).
# FRAME_WATCH_TICK_S=30
# FRAME_APP_WATCH=1
# Sports: leagues pulled separately (Polymarket tag slugs), and how many days ahead.
# FRAME_SPORTS_LEAGUES=premier-league
# FRAME_SPORTS_DAYS=3
# Optional live score feeds (off unless set). football-data.org free tier = delayed scores.
# FOOTBALL_DATA_API_KEY=
# ESPN's scoreboard JSON is unofficial (no published terms): personal use only.
# FRAME_SPORTS_ESPN=0
# What to scan by default (the app's checkboxes start from these; the monitor uses them as they are)
# FRAME_VENUES=polymarket,kalshi
# FRAME_CATEGORIES=all
# FRAME_SPORTS_LEAGUES=premier-league
